# Pinned FFmpeg CLI builds bundled into the Windows and macOS release packages.
# Consumed by .github/workflows/build_releases.yml, which loads every
# KEY=value line into $GITHUB_ENV (comment lines are filtered out).
# Format: strict KEY=value, no quotes, no `export`, `#` comments only.
#
# FFmpeg release branch: 8.1 on every platform (the Flatpak builds the 8.1.x
# source tarball in packaging/flatpak/org.unabara.unabara.yml).
#
# License: all bundled builds are configured with --enable-gpl
# --enable-version3 (libx264, libx265, libvpx), so the binaries are
# distributed under the GNU GPL v3. The license text ships next to the
# binaries as ffmpeg-LICENSE.txt.
#
# Corresponding source (GPL source offer):
#   FFmpeg:        https://ffmpeg.org/releases/  (git: https://git.ffmpeg.org/ffmpeg.git, branch release/8.1)
#   Windows build: https://github.com/BtbN/FFmpeg-Builds (build scripts; the
#                  exact FFmpeg commit is the gXXXXXXXXXX suffix of the asset name)
#   macOS builds:  https://ffmpeg.martin-riedl.de/ (build scripts:
#                  https://git.martin-riedl.de/ffmpeg/build-script)
#
# Updating: pick new assets, re-download them and recompute the SHA-256
# (or copy it from the publisher's checksum file), then update the triples
# below. Never pin a non-month-end BtbN tag: BtbN prunes daily autobuilds
# after a few weeks but keeps the month-end ones for years.

# --- Windows x64: BtbN static GPL build (release/8.1 branch, n8.1.2-50) ---
# Published checksum: https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-2026-08-31-13-27/checksums.sha256
# Zip layout: <asset-stem>/bin/{ffmpeg,ffprobe,ffplay}.exe + <asset-stem>/LICENSE.txt (GPLv3)
FFMPEG_WIN_TAG=autobuild-2026-08-31-13-27
FFMPEG_WIN_ASSET=ffmpeg-n8.1.2-50-g1a748fe2cd-win64-gpl-8.1.zip
FFMPEG_WIN_URL=https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-2026-08-31-13-27/ffmpeg-n8.1.2-50-g1a748fe2cd-win64-gpl-8.1.zip
FFMPEG_WIN_SHA256=273abb45f3f9f76c303e35ff39f5bb6c23c163ae65f6244a32b7d4a7f6cf0616

# --- macOS: Martin Riedl static release builds, FFmpeg 8.1.2 ---
# One binary per zip, Developer ID-signed by the publisher, minimum macOS 12.0
# (matches the app's LSMinimumSystemVersion). Only system dylibs are linked.
# Published checksums: <url>.sha256 next to each zip.
# Detail pages: https://ffmpeg.martin-riedl.de/info/detail/macos/arm64/1783011502_8.1.2
#               https://ffmpeg.martin-riedl.de/info/detail/macos/amd64/1783018342_8.1.2
FFMPEG_MAC_ARM64_FFMPEG_URL=https://ffmpeg.martin-riedl.de/download/macos/arm64/1783011502_8.1.2/ffmpeg.zip
FFMPEG_MAC_ARM64_FFMPEG_SHA256=ef1aa60006c7b77ce170c1608c08d8e4ba1c30c5746f2ac986ded932d0ac2c3c
FFMPEG_MAC_ARM64_FFPROBE_URL=https://ffmpeg.martin-riedl.de/download/macos/arm64/1783011502_8.1.2/ffprobe.zip
FFMPEG_MAC_ARM64_FFPROBE_SHA256=c39787f4af7a3932502d2d48db6f6feaaa836b48a73ef78c32cc3285df61dfaf
FFMPEG_MAC_X86_64_FFMPEG_URL=https://ffmpeg.martin-riedl.de/download/macos/amd64/1783018342_8.1.2/ffmpeg.zip
FFMPEG_MAC_X86_64_FFMPEG_SHA256=a52ef43883f44c219766d4b3bdde4e635b35465d0b704c01c3a0566b59775df9
FFMPEG_MAC_X86_64_FFPROBE_URL=https://ffmpeg.martin-riedl.de/download/macos/amd64/1783018342_8.1.2/ffprobe.zip
FFMPEG_MAC_X86_64_FFPROBE_SHA256=5408ca588c8c72b0dde3afe676d0a7acf25ef97e55ae6eba5c7bede1cda42695

# --- License text for the macOS bundle (the Martin Riedl zips carry none) ---
# FFmpeg's own COPYING.GPLv3 at tag n8.1.2; byte-identical to BtbN's LICENSE.txt.
FFMPEG_LICENSE_URL=https://raw.githubusercontent.com/FFmpeg/FFmpeg/n8.1.2/COPYING.GPLv3
FFMPEG_LICENSE_SHA256=8ceb4b9ee5adedde47b31e975c1d90c73ad27b6b165a1dcd80c7c545eb65b903
